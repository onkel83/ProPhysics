# ==========================================================================
# ProPhysics - NMAKE Build Automation
# File: ProPhysics/Makefile.nmake (Lokales SDK-Skript)
# Architecture: MSVC x64 Architecture Optimization (Core Engine DLL Only)
# ==========================================================================

CC = cl.exe
LINKER = link.exe

# ==========================================================================
# HIGH-PERFORMANCE COMPILER FLAGS
# /O2: Maximale Geschwindigkeit
# /Ob2: Aggressives Inlining (Inlined alles, was sinnvoll ist)
# /Oi: Erzeugt intrinsische Funktionen (Hardware-nahe Rechenpfade)
# /GL: Whole Program Optimization (Ermöglicht modulübergreifende Optimierung)
# /MP: Nutzt alle CPU-Kerne für die parallele Kompilierung
# ==========================================================================
CFLAGS = /nologo /O2 /Ob2 /Oi /GL /W4 /MP /I. /D_CRT_SECURE_NO_WARNINGS

# DLL-spezifisches Export-Macro injecten
DLL_FLAGS = /DPROPHYSICS_EXPORTS

# Verzeichnisse
OUT_DIR = ..\bin\ProPhysics

# Endprodukt-Target
DLL_TARGET = $(OUT_DIR)\ProPhysics.dll

# Object Files
OBJ_KERNEL = $(OUT_DIR)\ProPhysics.obj

# Alle 5 Core-Schnittstellen-Header für den standalone SDK-Export
HEADERS = ProPhysics.h \
          ProPhysics_Config.h \
          ProPhysics_Types.h \
          ProPhysics_Exports.h \
          ProPhysics_Version.h

# Master-Target: Erzeugt Verzeichnisse, baut DLL und exportiert SDK-Header
all: setup $(DLL_TARGET) copy_headers

setup:
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)

# 1. Kernel Objektdatei kompilieren (/GL sorgt für optimierten Intermediär-Code)
$(OBJ_KERNEL): ProPhysics.c $(HEADERS)
	$(CC) $(CFLAGS) $(DLL_FLAGS) /c ProPhysics.c /Fo$(OBJ_KERNEL)

# 2. DLL und zugehörige Import-Lib (.lib) erzeugen (/LTCG vollendet das Whole Program Optimization)
$(DLL_TARGET): $(OBJ_KERNEL)
	@echo [LINKING] Erzeuge hochoptimierten Engine-Kernel ($(DLL_TARGET))...
	$(LINKER) /nologo /DLL /LTCG /OUT:$(DLL_TARGET) $(OBJ_KERNEL)
	@if exist $(OBJ_KERNEL) del /Q $(OBJ_KERNEL)
	@if exist $(OUT_DIR)\ProPhysics.exp del /Q $(OUT_DIR)\ProPhysics.exp
	@echo [CLEANUP] Temporäre Compiler-Dateien (.obj, .exp) erfolgreich entfernt.

# Exportiert alle 5 Core-SDK-Header direkt in das neue ProPhysics-Produktverzeichnis
copy_headers:
	@echo [EXPORT] Kopiere Core-Header-Schnittstellen nach $(OUT_DIR)...
	@copy /Y ProPhysics.h $(OUT_DIR)\ >nul
	@copy /Y ProPhysics_Config.h $(OUT_DIR)\ >nul
	@copy /Y ProPhysics_Types.h $(OUT_DIR)\ >nul
	@copy /Y ProPhysics_Exports.h $(OUT_DIR)\ >nul
	@copy /Y ProPhysics_Version.h $(OUT_DIR)\ >nul

# Radikale Bereinigung des lokalen Produktzweigs
clean:
	@if exist $(OUT_DIR) del /Q $(OUT_DIR)\*
	@if exist $(OUT_DIR) rmdir $(OUT_DIR)
	@echo [DEEP CLEAN] ProPhysics-Build-Verzeichnis vollständig vernichtet.