# ==========================================================================
# ProPhysics - Observer Local Build Automation
# File: Observer/Makefile.nmake
# Architecture: MSVC x64 Compiled Console Application
# ==========================================================================

CC = cl.exe
LINKER = link.exe

# Compiler-Flags: Bindet die SDK-Header direkt aus den bin/ Auslieferungsverzeichnissen ein
CFLAGS = /nologo /O2 /W4 /MP /I. /I..\bin\ProPhysics /I..\bin\ProDiBatch /D_CRT_SECURE_NO_WARNINGS

# Ziel- und Quellverzeichnis-Kapselung
BIN_DIR = ..\bin
PROPHYSICS_SDK = ..\bin\ProPhysics
PRODIBATCH_SDK = ..\bin\ProDiBatch

EXE_TARGET = $(BIN_DIR)\Observer.exe
OBJ_FILE = Observer.obj

# Master-Target des lokalen Verbunds
all: $(EXE_TARGET) copy_runtime_dlls clean_tmp

# Kompilierung und Verlinkung der ausführbaren Datei mit den SDK-Import-Bibliotheken
$(EXE_TARGET): Observer.c Observer_Version.h Observer_Config.h
	@echo [COMPILING]: Kompiliere Observer-Schnittstellen...
	$(CC) $(CFLAGS) /c Observer.c /Fo$(OBJ_FILE)
	@echo [LINKING]: Erzeuge Standalone-Anwendung (Observer.exe)...
	$(LINKER) /nologo /OUT:$(EXE_TARGET) $(OBJ_FILE) $(PROPHYSICS_SDK)\ProPhysics.lib $(PRODIBATCH_SDK)\ProDiBatch.lib

# Holt sich die Dynamic Link Libraries für den nativen Support direkt in den ausführbaren bin/-Zweig
copy_runtime_dlls:
	@echo [DEPENDENCY]: Spiegele Dynamic Link Libraries für Runtime-Support nach $(BIN_DIR)...
	@if exist $(PROPHYSICS_SDK)\ProPhysics.dll copy /Y $(PROPHYSICS_SDK)\ProPhysics.dll $(BIN_DIR)\ >nul
	@if exist $(PRODIBATCH_SDK)\ProDiBatch.dll copy /Y $(PRODIBATCH_SDK)\ProDiBatch.dll $(BIN_DIR)\ >nul

# Post-Build-Aufräumen des lokalen Ordners
clean_tmp:
	@if exist $(OBJ_FILE) del /Q $(OBJ_FILE)
	@echo [CLEANUP]: Lokaler transienter Objekt-Müll erfolgreich entfernt.

clean:
	@if exist $(OBJ_FILE) del /Q $(OBJ_FILE)
	@if exist $(EXE_TARGET) del /Q $(EXE_TARGET)
	@echo [DEEP CLEAN]: Lokale Observer-Artefakte gelöscht.