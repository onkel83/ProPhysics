# ==========================================================================
# ProPhysics - Test NMAKE Build
# File:    build\test\Makefile.nmake
# Kernel:  1.23.0
# Etappe:  23
# Version: 3.3 — Alpha-Test + Example-Tests
#
# Aufruf:  aus beliebigem CWD.
#          Pfade werden ueber $(MAKEDIR) relativ zum Ablageort dieses
#          Makefiles abgeleitet — kein CWD-Hardcoding.
#
#   nmake                        -- alle Test-EXEs
#   nmake CONFIG=debug           -- Debug-Build (Default: release)
#   nmake clean                  -- Artefakte entfernen
#   nmake help                   -- Uebersicht
#
# Struktur:
#   Quellen:     $(ROOT)\src\test\*.c
#   Test-Header: $(ROOT)\src\test\header\alpha_test_common.h
#   Kern-Header: $(ROOT)\src\prophysics\header\*.h
#   SDK-Header:  $(ROOT)\src\sdk\header\pro_sdk_interface.h
#
#   Kern-Lib:    $(ROOT)\lib\ProPhysics.lib
#   SDK-Lib:     $(ROOT)\lib\pro_sdk_interface.lib
#
#   Ziel-EXEs:   $(ROOT)\bin\example_alpha_test.exe
#                $(ROOT)\bin\example_test_density.exe
#                $(ROOT)\bin\example_test_tensor.exe
#
#   OBJ:         $(MAKEDIR)\_obj\  (temporaer, wird nach Link geloescht)
#
# Voraussetzung: ProPhysics.lib UND pro_sdk_interface.lib muessen
#                bereits existieren. Reihenfolge: prophysics -> sdk -> test.
#
# Die EXEs liegen im selben Ordner wie die DLLs (bin\), damit der
# Windows-Loader sie ohne PATH-Anpassung findet.
#
# Etappe 22-Refactoring: alpha_test_su2.c hinzugefuegt (Prio 8).
# Etappe 23:             alpha_test_running_coupling.c hinzugefuegt (Prio 8).
# Etappe 23b:            alpha_test_creutz_ratio.c hinzugefuegt (Prio 8).
#
# Parameter:
#   CONFIG   release | debug   (Default: release)
# ==========================================================================

# --------------------------------------------------------------------------
# Konfiguration -- validiert, damit Tippfehler frueh auffallen.
# --------------------------------------------------------------------------
!IFNDEF CONFIG
CONFIG = release
!ENDIF
!IF "$(CONFIG)" != "release"
!IF "$(CONFIG)" != "debug"
!ERROR CONFIG muss "release" oder "debug" sein (erhalten: "$(CONFIG)")
!ENDIF
!ENDIF

# --------------------------------------------------------------------------
# Pfade relativ zum Ablageort dieses Makefiles.
# --------------------------------------------------------------------------
ROOT         = $(MAKEDIR)\..\..
SRC_DIR      = $(ROOT)\src\test
TEST_HDR_DIR = $(ROOT)\src\test\header
CORE_HDR_DIR = $(ROOT)\src\prophysics\header
SDK_HDR_DIR  = $(ROOT)\src\sdk\header
OBJ_DIR      = $(MAKEDIR)\_obj
BIN_DIR      = $(ROOT)\bin
LIB_DIR      = $(ROOT)\lib

# Import-Libs der Vorgaenger-Builds
CORE_LIB = $(LIB_DIR)\ProPhysics.lib
SDK_LIB  = $(LIB_DIR)\pro_sdk_interface.lib

# Ziel-EXEs
EXE_ALPHA    = $(BIN_DIR)\example_alpha_test.exe
EXE_DENSITY  = $(BIN_DIR)\example_test_density.exe
EXE_TENSOR   = $(BIN_DIR)\example_test_tensor.exe

CC     = cl.exe
LINKER = link.exe

# --------------------------------------------------------------------------
# Compiler-Flags pro Config
#
# /I-Pfade:
#   $(TEST_HDR_DIR)  -- alpha_test_common.h
#   $(CORE_HDR_DIR)  -- ProPhysics.h, ProPhysics_Types.h, ...
#   $(SDK_HDR_DIR)   -- pro_sdk_interface.h
#
# /arch:AVX2 wie im Kernel-Build, damit die Test-EXEs den gleichen
# Befehlssatz nutzen.
# --------------------------------------------------------------------------
CFLAGS_COMMON = /nologo /W3 /MP /arch:AVX2 /D_CRT_SECURE_NO_WARNINGS \
                /I"$(TEST_HDR_DIR)" \
                /I"$(CORE_HDR_DIR)" \
                /I"$(SDK_HDR_DIR)"

!IF "$(CONFIG)" == "release"
CFLAGS  = $(CFLAGS_COMMON) /O2 /Ob2 /Oi /GL
LFLAGS  = /LTCG
!ELSE
CFLAGS  = $(CFLAGS_COMMON) /Od /Zi /MDd
LFLAGS  = /DEBUG
!ENDIF

# --------------------------------------------------------------------------
# Test-Quellen: Alpha-Test (multi-file) und Example-Tests (single-file)
#
# Etappe 22:  alpha_test_su2.c hinzugefuegt.
# Etappe 23:  alpha_test_running_coupling.c hinzugefuegt.
# Etappe 23b: alpha_test_creutz_ratio.c hinzugefuegt.
# Damit enthaelt example_alpha_test.exe 18 Objektdateien.
# --------------------------------------------------------------------------
ALPHA_SOURCES = \
    $(SRC_DIR)\alpha_test_main.c \
    $(SRC_DIR)\alpha_test_common.c \
    $(SRC_DIR)\alpha_test_basic.c \
    $(SRC_DIR)\alpha_test_chsh.c \
    $(SRC_DIR)\alpha_test_born.c \
    $(SRC_DIR)\alpha_test_invariance.c \
    $(SRC_DIR)\alpha_test_soliton.c \
    $(SRC_DIR)\alpha_test_qm_basics.c \
    $(SRC_DIR)\alpha_test_qm_advanced.c \
    $(SRC_DIR)\alpha_test_qm_emergent.c \
    $(SRC_DIR)\alpha_test_3d.c \
    $(SRC_DIR)\alpha_test_hydrogen.c \
    $(SRC_DIR)\alpha_test_shared.c \
    $(SRC_DIR)\alpha_test_spin.c \
    $(SRC_DIR)\alpha_test_dirac.c \
    $(SRC_DIR)\alpha_test_su2.c \
    $(SRC_DIR)\alpha_test_running_coupling.c \
    $(SRC_DIR)\alpha_test_creutz_ratio.c

EXAMPLE_SOURCES = \
    $(SRC_DIR)\example_test_density.c \
    $(SRC_DIR)\example_test_tensor.c

# --------------------------------------------------------------------------
# Header als Dependency
# --------------------------------------------------------------------------
TEST_HEADERS = $(TEST_HDR_DIR)\alpha_test_common.h

CORE_HEADERS = \
    $(CORE_HDR_DIR)\ProPhysics.h \
    $(CORE_HDR_DIR)\ProPhysics_Config.h \
    $(CORE_HDR_DIR)\ProPhysics_Types.h \
    $(CORE_HDR_DIR)\ProPhysics_Exports.h \
    $(CORE_HDR_DIR)\ProPhysics_Version.h

SDK_HEADERS = $(SDK_HDR_DIR)\pro_sdk_interface.h

HEADERS_ALL = $(TEST_HEADERS) $(CORE_HEADERS) $(SDK_HEADERS)

# --------------------------------------------------------------------------
# Master-Target
# --------------------------------------------------------------------------
all: check_deps setup $(EXE_ALPHA) $(EXE_DENSITY) $(EXE_TENSOR) postclean
	@echo [DONE] Test-Artefakte in $(BIN_DIR) erstellt.

# Vorabpruefung: beide Import-Libs muessen existieren.
check_deps:
	@if not exist "$(CORE_LIB)" ( \
	    echo [FEHLER] $(CORE_LIB) fehlt. Zuerst build\prophysics bauen. & \
	    exit /B 1 \
	)
	@if not exist "$(SDK_LIB)" ( \
	    echo [FEHLER] $(SDK_LIB) fehlt. Zuerst build\sdk bauen. & \
	    exit /B 1 \
	)

setup:
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	@if not exist "$(BIN_DIR)" mkdir "$(BIN_DIR)"

help:
	@echo.
	@echo ProPhysics Test-Build -- Targets:
	@echo   all            example_alpha_test.exe + example_test_density.exe
	@echo                  + example_test_tensor.exe (Default)
	@echo   clean          Artefakte entfernen
	@echo   help           diese Uebersicht
	@echo.
	@echo Optionen:  CONFIG=release^|debug   (Default: release)
	@echo.

# --------------------------------------------------------------------------
# Beispiel-Tests (single-file)
#
# MSVC kompiliert + linkt in einem Schritt, wenn /Fe gesetzt ist und
# kein /c. Die OBJ-Datei landet via /Fo in _obj\.
# --------------------------------------------------------------------------
$(EXE_DENSITY): $(SRC_DIR)\example_test_density.c $(HEADERS_ALL) $(CORE_LIB) $(SDK_LIB)
	@echo [CC+LINK] $(EXE_DENSITY)  (CONFIG=$(CONFIG))
	$(CC) $(CFLAGS) "$(SRC_DIR)\example_test_density.c" \
	    /Fo"$(OBJ_DIR)\\" /Fe$@ \
	    /link $(LFLAGS) $(SDK_LIB) $(CORE_LIB)

$(EXE_TENSOR): $(SRC_DIR)\example_test_tensor.c $(HEADERS_ALL) $(CORE_LIB) $(SDK_LIB)
	@echo [CC+LINK] $(EXE_TENSOR)  (CONFIG=$(CONFIG))
	$(CC) $(CFLAGS) "$(SRC_DIR)\example_test_tensor.c" \
	    /Fo"$(OBJ_DIR)\\" /Fe$@ \
	    /link $(LFLAGS) $(SDK_LIB) $(CORE_LIB)

# --------------------------------------------------------------------------
# Alpha-Test (multi-file)
#
# Alle 18 Quellen werden in EINEM cl.exe-Aufruf kompiliert und gelinkt.
# Bei /MP uebersetzt cl.exe die Dateien parallel, der Link passiert am
# Ende des Aufrufs. /Fo"$(OBJ_DIR)\\" mit abschliessendem Backslash
# stellt sicher, dass cl.exe die OBJs dort ablegt (nicht im CWD).
# --------------------------------------------------------------------------
$(EXE_ALPHA): $(ALPHA_SOURCES) $(HEADERS_ALL) $(CORE_LIB) $(SDK_LIB)
	@echo [CC+LINK] $(EXE_ALPHA)  (18 Quellen, CONFIG=$(CONFIG))
	$(CC) $(CFLAGS) $(ALPHA_SOURCES) \
	    /Fo"$(OBJ_DIR)\\" /Fe$@ \
	    /link $(LFLAGS) $(SDK_LIB) $(CORE_LIB)

# --------------------------------------------------------------------------
# Aufraeumen der OBJ-Reste nach jedem erfolgreichen Link
# --------------------------------------------------------------------------
postclean:
	@if exist "$(OBJ_DIR)\*.obj" del /Q "$(OBJ_DIR)\*.obj" 2>nul
	@if exist "$(OBJ_DIR)\*.exp" del /Q "$(OBJ_DIR)\*.exp" 2>nul
	@if exist "$(OBJ_DIR)\*.lib" del /Q "$(OBJ_DIR)\*.lib" 2>nul
	@echo [CLEANUP] OBJ/EXP/LIB-Reste entfernt.

# --------------------------------------------------------------------------
# Clean
# --------------------------------------------------------------------------
clean:
	@if exist "$(OBJ_DIR)" del /Q /F /S "$(OBJ_DIR)\*.*" 2>nul
	@if exist "$(OBJ_DIR)" rmdir /S /Q "$(OBJ_DIR)" 2>nul
	@if exist "$(EXE_ALPHA)"   del /Q "$(EXE_ALPHA)"   2>nul
	@if exist "$(EXE_DENSITY)" del /Q "$(EXE_DENSITY)" 2>nul
	@if exist "$(EXE_TENSOR)"  del /Q "$(EXE_TENSOR)"  2>nul
	@echo [DEEP CLEAN] Test-Artefakte entfernt.