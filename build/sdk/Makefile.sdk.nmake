# ==========================================================================
# ProPhysics - SDK Interface NMAKE Build
# File:    build\sdk\Makefile.sdk.nmake
# Kernel:  1.23.0
# Etappe:  23
# Version: 3.2 — SDK-Interface (Single .c)
#
# Aufruf:  aus beliebigem CWD.
#          Pfade werden ueber $(MAKEDIR) relativ zum Ablageort dieses
#          Makefiles abgeleitet — kein CWD-Hardcoding.
#
#   nmake                        -- pro_sdk_interface.dll + .lib
#   nmake CONFIG=debug           -- Debug-Build (Default: release)
#   nmake clean                  -- Artefakte entfernen
#   nmake help                   -- Uebersicht
#
# Struktur:
#   Quelle:      $(ROOT)\src\sdk\pro_sdk_interface.c
#   SDK-Header:  $(ROOT)\src\sdk\header\pro_sdk_interface.h
#   Kern-Header: $(ROOT)\src\prophysics\header\*.h
#   Kern-Lib:    $(ROOT)\lib\ProPhysics.lib          (aus prophysics-Build)
#   Ziel DLL:    $(ROOT)\bin\pro_sdk_interface.dll
#   Ziel LIB:    $(ROOT)\lib\pro_sdk_interface.lib
#   OBJ:         $(MAKEDIR)\_obj\  (temporaer, wird nach Link geloescht)
#
# Voraussetzung: ProPhysics.lib muss bereits existieren.
#                Reihenfolge: prophysics -> sdk -> test.
#
# Parameter:
#   CONFIG   release | debug   (Default: release)
# ==========================================================================

# --------------------------------------------------------------------------
# Konfiguration -- validiert, damit Tippfehler frueh auffallen.
# --------------------------------------------------------------------------
!IFNDEF CONFIG
CONFIG = release
!ENDIF
!IF "$(CONFIG)" != "release"
!IF "$(CONFIG)" != "debug"
!ERROR CONFIG muss "release" oder "debug" sein (erhalten: "$(CONFIG)")
!ENDIF
!ENDIF

# --------------------------------------------------------------------------
# Pfade relativ zum Ablageort dieses Makefiles.
# --------------------------------------------------------------------------
ROOT      = $(MAKEDIR)\..\..
SRC_DIR   = $(ROOT)\src\sdk
HDR_DIR   = $(ROOT)\src\sdk\header
CORE_HDR  = $(ROOT)\src\prophysics\header
OBJ_DIR   = $(MAKEDIR)\_obj
BIN_DIR   = $(ROOT)\bin
LIB_DIR   = $(ROOT)\lib

DLL_TARGET = $(BIN_DIR)\pro_sdk_interface.dll
LIB_TARGET = $(LIB_DIR)\pro_sdk_interface.lib

# Import-Lib des Kernels (aus vorherigem Build-Schritt)
CORE_LIB = $(LIB_DIR)\ProPhysics.lib

CC     = cl.exe
LINKER = link.exe

# --------------------------------------------------------------------------
# Compiler-Flags pro Config
#
# /I-Pfade:
#   $(HDR_DIR)   -- pro_sdk_interface.h
#   $(CORE_HDR)  -- ProPhysics.h, ProPhysics_Types.h, ...
# --------------------------------------------------------------------------
CFLAGS_COMMON = /nologo /W3 /MP /D_CRT_SECURE_NO_WARNINGS \
                /I"$(HDR_DIR)" /I"$(CORE_HDR)"

!IF "$(CONFIG)" == "release"
CFLAGS  = $(CFLAGS_COMMON) /O2 /Ob2 /Oi /GL
LFLAGS  = /LTCG
!ELSE
CFLAGS  = $(CFLAGS_COMMON) /Od /Zi /MDd
LFLAGS  = /DEBUG
!ENDIF

# DLL-spezifisches Export-Macro
DLL_FLAGS = /DPRO_SDK_EXPORTS

# --------------------------------------------------------------------------
# Modul (Single Source)
# --------------------------------------------------------------------------
OBJ_SDK = $(OBJ_DIR)\pro_sdk_interface.obj

# --------------------------------------------------------------------------
# Header als Dependency
#
# Zwei Saetze:
#   SDK-Header  -- pro_sdk_interface.h
#   Kern-Header -- ProPhysics.h etc. (fuer die API-Deklarationen)
# --------------------------------------------------------------------------
HEADERS_SDK = $(HDR_DIR)\pro_sdk_interface.h

HEADERS_CORE = \
    $(CORE_HDR)\ProPhysics.h \
    $(CORE_HDR)\ProPhysics_Config.h \
    $(CORE_HDR)\ProPhysics_Types.h \
    $(CORE_HDR)\ProPhysics_Exports.h \
    $(CORE_HDR)\ProPhysics_Version.h

HEADERS_ALL = $(HEADERS_SDK) $(HEADERS_CORE)

# --------------------------------------------------------------------------
# Master-Target
# --------------------------------------------------------------------------
all: check_core setup $(DLL_TARGET)

# Vorabpruefung: ProPhysics.lib muss existieren.
check_core:
	@if not exist "$(CORE_LIB)" ( \
	    echo [FEHLER] $(CORE_LIB) fehlt. Zuerst build\prophysics bauen. & \
	    exit /B 1 \
	)

setup:
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	@if not exist "$(BIN_DIR)" mkdir "$(BIN_DIR)"
	@if not exist "$(LIB_DIR)" mkdir "$(LIB_DIR)"

help:
	@echo.
	@echo ProPhysics SDK-Build -- Targets:
	@echo   all            pro_sdk_interface.dll + .lib (Default)
	@echo   clean          Artefakte entfernen
	@echo   help           diese Uebersicht
	@echo.
	@echo Optionen:  CONFIG=release^|debug   (Default: release)
	@echo.

# --------------------------------------------------------------------------
# Modul-Regel
# --------------------------------------------------------------------------
$(OBJ_SDK): $(SRC_DIR)\pro_sdk_interface.c $(HEADERS_ALL)
	$(CC) $(CFLAGS) $(DLL_FLAGS) /c "$(SRC_DIR)\pro_sdk_interface.c" /Fo$@

# --------------------------------------------------------------------------
# Link
#
# /LTCG wie im Kernel.
# /OUT    -> bin\pro_sdk_interface.dll
# /IMPLIB -> lib\pro_sdk_interface.lib
# CORE_LIB -> lib\ProPhysics.lib (Import-Lib des Kernels)
#
# Nach dem Link: OBJ und EXP weg.
# --------------------------------------------------------------------------
$(DLL_TARGET): $(OBJ_SDK) $(CORE_LIB)
	@echo [LINKING] $(DLL_TARGET)  (CONFIG=$(CONFIG))
	$(LINKER) /nologo /DLL $(LFLAGS) \
	    /OUT:$(DLL_TARGET) \
	    /IMPLIB:$(LIB_TARGET) \
	    $(OBJ_SDK) $(CORE_LIB)
	@if exist "$(OBJ_DIR)\*.obj" del /Q "$(OBJ_DIR)\*.obj" 2>nul
	@if exist "$(OBJ_DIR)\*.exp" del /Q "$(OBJ_DIR)\*.exp" 2>nul
	@echo [CLEANUP] OBJ/EXP entfernt.

# --------------------------------------------------------------------------
# Clean
# --------------------------------------------------------------------------
clean:
	@if exist "$(OBJ_DIR)" del /Q /F /S "$(OBJ_DIR)\*.*" 2>nul
	@if exist "$(OBJ_DIR)" rmdir /S /Q "$(OBJ_DIR)" 2>nul
	@if exist "$(DLL_TARGET)" del /Q "$(DLL_TARGET)" 2>nul
	@if exist "$(LIB_TARGET)" del /Q "$(LIB_TARGET)" 2>nul
	@echo [DEEP CLEAN] SDK-Interface-Artefakte entfernt.