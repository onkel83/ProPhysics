# ==========================================================================
# ProPhysics - Master Build
# File: build\main\Makefile.nmake
# Version: 3.0
#
# Aufruf: aus build\main\ heraus
#   nmake                    -- baut Kernel + SDK + Tests, schreibt BUILD_INFO
#   nmake all                -- identisch
#
# Einzel-Targets:
#   nmake prophysics         -- nur Kernel
#   nmake sdk                -- Kernel + SDK
#   nmake test               -- Kernel + SDK + Tests
#   nmake info               -- nur BUILD_INFO.txt neu erzeugen
#
# Rebuild (clean + build):
#   nmake rebuild            -- alles neu
#   nmake rebuild_prophysics -- Kernel neu
#   nmake rebuild_sdk        -- SDK neu (Kernel bleibt)
#   nmake rebuild_test       -- Tests neu (Kernel + SDK bleiben)
#
# Clean:
#   nmake clean              -- bin\ und lib\ vollstaendig leeren
#   nmake clean_prophysics   -- nur Kernel-Artefakte weg
#   nmake clean_sdk          -- nur SDK-Artefakte weg
#   nmake clean_test         -- nur Test-Artefakte weg
#
# Ausgabe:
#   bin\   -- alle DLLs und EXEs
#   lib\   -- alle Import-Libs
#   \      -- BUILD_INFO.txt
# ==========================================================================

# --------------------------------------------------------------------------
# Pfade relativ zum Ablageort dieses Makefiles.
# $(MAKEDIR) wird von NMAKE auf das Verzeichnis gesetzt, aus dem dieses
# Makefile geladen wurde. So funktioniert der Aufruf unabhaengig vom CWD.
# --------------------------------------------------------------------------
ROOT       = $(MAKEDIR)\..\..
BIN_DIR    = $(ROOT)\bin
LIB_DIR    = $(ROOT)\lib
BUILD_PP   = $(ROOT)\build\prophysics
BUILD_SDK  = $(ROOT)\build\sdk
BUILD_TST  = $(ROOT)\build\test
INFO_FILE  = $(ROOT)\BUILD_INFO.txt
INFO_SCRIPT= $(MAKEDIR)\write_build_info.ps1

# --------------------------------------------------------------------------
# Default-Target
# --------------------------------------------------------------------------
all: setup prophysics sdk test info

# --------------------------------------------------------------------------
# Setup: bin\ und lib\ anlegen falls noetig
# --------------------------------------------------------------------------
setup:
	@if not exist "$(BIN_DIR)" ( \
	    mkdir "$(BIN_DIR)" & \
	    echo [MASTER] bin\ angelegt \
	)
	@if not exist "$(LIB_DIR)" ( \
	    mkdir "$(LIB_DIR)" & \
	    echo [MASTER] lib\ angelegt \
	)

# --------------------------------------------------------------------------
# Kernel
# --------------------------------------------------------------------------
prophysics: setup
	@echo.
	@echo [MASTER] === ProPhysics Kernel ===
	cd /d "$(BUILD_PP)" && nmake /NOLOGO /f Makefile.nmake

# --------------------------------------------------------------------------
# SDK (Kernel wird vorausgesetzt, Kettenabhaengigkeit)
# --------------------------------------------------------------------------
sdk: prophysics
	@echo.
	@echo [MASTER] === SDK Interface ===
	cd /d "$(BUILD_SDK)" && nmake /NOLOGO /f Makefile.sdk.nmake

# --------------------------------------------------------------------------
# Tests (SDK wird vorausgesetzt, Kettenabhaengigkeit)
# --------------------------------------------------------------------------
test: sdk
	@echo.
	@echo [MASTER] === Tests ===
	cd /d "$(BUILD_TST)" && nmake /NOLOGO /f Makefile.nmake

# --------------------------------------------------------------------------
# BUILD_INFO.txt
# --------------------------------------------------------------------------
info:
	@echo.
	@echo [MASTER] === BUILD_INFO ===
	@powershell -NoProfile -ExecutionPolicy Bypass -File "$(INFO_SCRIPT)" -RepoRoot "$(ROOT)"

# --------------------------------------------------------------------------
# Rebuild-Targets
# --------------------------------------------------------------------------
rebuild: clean all

rebuild_prophysics: clean_prophysics prophysics info

rebuild_sdk: clean_sdk sdk info

rebuild_test: clean_test test info

# --------------------------------------------------------------------------
# Clean-Targets
#
# clean = bin\ und lib\ leer + BUILD_INFO.txt weg.
# clean_<modul> = nur die Artefakte des jeweiligen Moduls.
# --------------------------------------------------------------------------
clean: clean_test clean_sdk clean_prophysics
	@if exist "$(BIN_DIR)\*" del /Q "$(BIN_DIR)\*" 2>nul
	@if exist "$(LIB_DIR)\*" del /Q "$(LIB_DIR)\*" 2>nul
	@if exist "$(INFO_FILE)" del /Q "$(INFO_FILE)" 2>nul
	@echo [MASTER] Alle Artefakte entfernt.

clean_prophysics:
	@echo [MASTER] Clean ProPhysics...
	@if exist "$(BUILD_PP)" cd /d "$(BUILD_PP)" && nmake /NOLOGO /f Makefile.nmake clean
	@if exist "$(BIN_DIR)\ProPhysics.dll" del /Q "$(BIN_DIR)\ProPhysics.dll" 2>nul
	@if exist "$(LIB_DIR)\ProPhysics.lib" del /Q "$(LIB_DIR)\ProPhysics.lib" 2>nul

clean_sdk:
	@echo [MASTER] Clean SDK...
	@if exist "$(BUILD_SDK)" cd /d "$(BUILD_SDK)" && nmake /NOLOGO /f Makefile.sdk.nmake clean
	@if exist "$(BIN_DIR)\pro_sdk_interface.dll" del /Q "$(BIN_DIR)\pro_sdk_interface.dll" 2>nul
	@if exist "$(LIB_DIR)\pro_sdk_interface.lib" del /Q "$(LIB_DIR)\pro_sdk_interface.lib" 2>nul

clean_test:
	@echo [MASTER] Clean Tests...
	@if exist "$(BUILD_TST)" cd /d "$(BUILD_TST)" && nmake /NOLOGO /f Makefile.nmake clean
	@if exist "$(BIN_DIR)\example_alpha_test.exe"  del /Q "$(BIN_DIR)\example_alpha_test.exe"  2>nul
	@if exist "$(BIN_DIR)\example_test_density.exe" del /Q "$(BIN_DIR)\example_test_density.exe" 2>nul
	@if exist "$(BIN_DIR)\example_test_tensor.exe"  del /Q "$(BIN_DIR)\example_test_tensor.exe"  2>nul